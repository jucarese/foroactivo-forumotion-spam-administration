{
  "manifest_version": 3,
  "name": "Administración de spam para Foroactivo",
  "version": "1.1.5",
  "description": "Herramienta administrativa para registrar y eliminar en lote los temas y mensajes de un usuario.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Limpiar mensajes de un usuario",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "foroactivo-borrado-masivo@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
